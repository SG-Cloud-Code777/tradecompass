# --- required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tradecompass
# SEC requires a descriptive User-Agent with contact email for EDGAR API access
SEC_USER_AGENT="TradeCompass your-email@example.com"

# --- market data (Yahoo-compatible endpoints need no key; others are fallbacks/alternatives) ---
MARKET_DATA_PROVIDERS=yahoo,twelvedata,alphavantage
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
# optional: congressional trades (Financial Modeling Prep)
FMP_API_KEY=
# optional: higher OpenFIGI rate limit for CUSIP -> ticker mapping
OPENFIGI_API_KEY=

# --- push notifications (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

PORT=8787
# run scheduled jobs in this process (set false when running jobs in a separate worker)
ENABLE_JOBS=true
